# Perspecta Central — variáveis de ambiente
#
# Nada aqui é obrigatório pro app subir: cada integração checa se as suas
# variáveis estão setadas e, se não estiverem, avisa "ainda não configurado"
# em vez de fingir que funcionou. Preencha e configure na Vercel (Project
# Settings → Environment Variables) conforme for ativando cada pedaço.
#
# Depois de mudar qualquer variável na Vercel, é preciso REDEPLOY pra valer.

# ── Login no próprio Central ──────────────────────────────────────────────
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SECRET=

# ── Banco da Central (Supabase, via Management API) ───────────────────────
# Token de management do projeto ndzdhseravwdcdfuroda (Supabase → Account →
# Access Tokens). Sem isso a Central roda inteira em modo mock.
SUPABASE_MANAGEMENT_TOKEN=

# ── Monitoramento de deploys (Vercel) ──────────────────────────────────────
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# ── Criar acesso automático: Perspecta Creator (Render) ───────────────────
# URL do serviço no Render — confirme em Render → Creator → dashboard
# (o render.yaml nomeia o serviço "saas-agency", então costuma ser
# https://saas-agency.onrender.com, mas o Render pode ter dado outro nome).
CREATOR_API_URL=
# Login do superadmin fixo do Creator (usuário sempre "admin").
CREATOR_USER=admin
# Senha: é o valor que ficou salvo em SEED_ADMIN_PASSWORD no Render do
# Creator quando essa conta foi criada. Olhe lá em Environment.
CREATOR_PASS=
# Só preencha se o login pedir organização explícita (raro pro superadmin).
CREATOR_ORG=

# ── Criar acesso automático: Perspecta Juris (Render) ──────────────────────
JURIS_API_URL=https://perspecta-juris.onrender.com
# Nome do escritório master (não muda, é fixo no seed do Juris).
JURIS_EMPRESA=Perspecta Juris
# Login do usuário master — "katelyn" é o padrão do seed, a não ser que
# MASTER_LOGIN tenha sido alterado no Render do Juris.
JURIS_USER=katelyn
# Senha: é o valor de MASTER_PASSWORD no Render do Juris. Se não lembrar,
# é mais rápido resetar (Render → Juris → Shell) do que tentar adivinhar.
JURIS_PASS=

# ── Criar acesso automático: Perspecta Commerce (Supabase) ────────────────
# Commerce usa o MESMO projeto Supabase da Central (ndzdhseravwdcdfuroda) —
# URL e chave anônima são as mesmas, só a service role é exclusiva daqui.
COMMERCE_SUPABASE_URL=https://ndzdhseravwdcdfuroda.supabase.co
COMMERCE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5kemRoc2VyYXZ3ZGNkZnVyb2RhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ0NzkxNTQsImV4cCI6MjEwMDA1NTE1NH0.WBubTxEtelbC5BSE6jzy06ZXWwe7C2vFnBUI3IH2tD8
# Chave secreta (Supabase → seu projeto → Settings → API → "service_role").
# O Commerce já usa essa mesma chave (variável SUPABASE_SERVICE_ROLE_KEY no
# Vercel dele) — pode copiar de lá em vez de ir atrás de novo.
COMMERCE_SUPABASE_SERVICE_ROLE_KEY=

# ── Criar acesso automático: Perspecta Bistro (Firebase) ──────────────────
# Ainda BLOQUEADO: falta descobrir como o Bistro gera o passHash das contas
# (veja o pedido de cadastrar uma empresa teste e me passar o valor).
# Uma das duas formas de passar a conta de serviço (nunca as duas):
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_DATABASE_URL=

# ── Pagamentos (Financeiro / cobrança dos clientes da Central) ────────────
# Só ativa os provedores que você realmente vai usar; o seletor em /config
# escolhe qual fica ativo, sem precisar redeploy pra trocar.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
ASAAS_API_KEY=
ASAAS_ENV=production
INFINITEPAY_HANDLE=

# ── Perspecta Hub (CRM) ────────────────────────────────────────────────────
# Repositório ainda vazio — nenhuma variável se aplica até o Hub existir.
